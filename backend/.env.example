# InsightAI Backend Environment Variables
PORT=8000
HOST=127.0.0.1
MAX_UPLOAD_SIZE_MB=100

# Optional AI LLM API Keys (Gemini, OpenAI, Groq)
# The application includes an integrated deterministic statistical execution engine
# and functions completely without requiring an external AI API key.
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
LLM_PROVIDER=gemini
